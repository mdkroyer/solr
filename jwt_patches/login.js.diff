+      function getIdTokenExpiry(idToken) {
+        if (!idToken) {
+            console.warn("⚠️ ID Token is missing.");
+            return null;
+        }
+
+        try {
+            const parts = idToken.split(".");
+            if (parts.length !== 3) {
+                throw new Error("Invalid JWT format.");
+            }
+    
+            // Decode Base64 URL payload
+            const payload = JSON.parse(atob(parts[1]));
+    
+            // Extract expiration timestamp (exp)
+            if (!payload.exp) {
+                throw new Error("❌ No 'exp' claim in ID Token.");
+            }
+    
+            return payload.exp * 1000; // Convert seconds to milliseconds
+        } catch (error) {
+            console.error("❌ Failed to extract expiry from ID Token:", error);
+            return null;
+        }
+      }
+
+      async function refreshToken() {
+        const refreshToken = sessionStorage.getItem("refresh_token");
+        if (!refreshToken) {
+            console.warn("⚠️ No refresh token available. User needs to reauthenticate.");
+            $location.path("/");
+            return;
+        }
+    
+        const tokenEndpoint = $scope.authData['tokenEndpoint']; // Ensure this is correct
+        const clientId = $scope.authData['client_id']; // Replace with actual client ID
+    
+        const data = new URLSearchParams({
+            "grant_type": "refresh_token",
+            "refresh_token": refreshToken,
+            "client_id": clientId
+        });
+    
+        try {
+            const response = await fetch(tokenEndpoint, {
+                method: "POST",
+                headers: { "Content-Type": "application/x-www-form-urlencoded" },
+                body: data
+            });
+    
+            if (!response.ok) {
+                throw new Error(`❌ Token refresh failed: ${response.statusText}`);
+            }
+
+            const tokenData = await response.json();
+            if (!tokenData.access_token) {
+                throw new Error("❌ Invalid token response from GitLab.");
+            }
+    
+            // Store new tokens
+            sessionStorage.setItem("access_token", tokenData.access_token);
+            sessionStorage.setItem("id_token", tokenData.id_token || "");
+            sessionStorage.setItem("refresh_token", tokenData.refresh_token || refreshToken);
+            sessionStorage.setItem("token_expiry", getIdTokenExpiry(tokenData.id_token));
+            sessionStorage.setItem("auth.header", "Bearer " + tokenData.id_token);
+    
+            console.log("✅ Token successfully refreshed.");
+    
+            // Reschedule token refresh
+            scheduleTokenRefresh();
+        } catch (error) {
+            console.error("❌ Token refresh error:", error);
+            $location.path("/"); // Log out user if refresh fails
+        }
+      }
+
+      function scheduleTokenRefresh() {
+        const tokenExpiry = sessionStorage.getItem("token_expiry");
+        if (!tokenExpiry) {
+            console.warn("⚠️ No token expiry time found.");
+            return;
+        }
+    
+        const expiresInMs = tokenExpiry - Date.now();
+        const refreshTime = expiresInMs / 4; // Refresh 1 minute before expiry
+    
+        if (refreshTime <= 0) {
+            console.warn("⚠️ Token already expired, refreshing now.");
+            refreshToken();
+        } else {
+            console.log(`🔄 Scheduling token refresh in ${refreshTime / 1000} seconds.`);
+            setTimeout(refreshToken, refreshTime);
+        }
+      }
